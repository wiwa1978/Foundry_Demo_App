{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "11520665464463378604"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for new resources."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Tags applied to created resources."
      }
    },
    "sharedResourceGroupName": {
      "type": "string",
      "defaultValue": "RG-AI-DEMO",
      "metadata": {
        "description": "Resource group where shared hub resources live (template 16 + hub-additions)."
      }
    },
    "containerRegistryName": {
      "type": "string",
      "metadata": {
        "description": "Existing ACR name in the hub RG."
      }
    },
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Existing Storage account name in the hub RG."
      }
    },
    "storageContainerName": {
      "type": "string",
      "defaultValue": "foundry-rag-documents",
      "metadata": {
        "description": "Blob container name for RAG uploads."
      }
    },
    "searchServiceName": {
      "type": "string",
      "metadata": {
        "description": "Existing AI Search service name in the hub RG."
      }
    },
    "searchIndexName": {
      "type": "string",
      "defaultValue": "foundry-document-rag",
      "metadata": {
        "description": "Azure AI Search index name."
      }
    },
    "foundryAccountName": {
      "type": "string",
      "metadata": {
        "description": "Existing Foundry account name in the hub RG."
      }
    },
    "containerAppsEnvironmentId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the shared Container Apps Environment (from hub-additions output)."
      }
    },
    "logAnalyticsWorkspaceName": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace name (per-app, for app-level logs)."
      }
    },
    "containerAppName": {
      "type": "string",
      "metadata": {
        "description": "Container App name."
      }
    },
    "containerAppManagedIdentityName": {
      "type": "string",
      "metadata": {
        "description": "User-assigned managed identity name for the Container App."
      }
    },
    "containerImage": {
      "type": "string",
      "defaultValue": "mcr.microsoft.com/azuredocs/containerapps-helloworld:latest",
      "metadata": {
        "description": "Container image to run. Use placeholder until app image is pushed to ACR."
      }
    },
    "foundryProjectEndpoint": {
      "type": "string",
      "metadata": {
        "description": "Foundry project endpoint."
      }
    },
    "foundryOpenAiEndpoint": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional Foundry OpenAI-compatible endpoint override."
      }
    },
    "foundryModels": {
      "type": "string",
      "metadata": {
        "description": "Comma-separated Foundry model deployment names."
      }
    },
    "foundryEmbeddingModel": {
      "type": "string",
      "defaultValue": "text-embedding-3-small",
      "metadata": {
        "description": "Foundry embedding deployment name."
      }
    },
    "foundryRealtimeEndpoint": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional Foundry realtime endpoint override."
      }
    },
    "foundryRealtimeModel": {
      "type": "string",
      "defaultValue": "gpt-realtime-2.1",
      "metadata": {
        "description": "Foundry realtime model deployment name."
      }
    },
    "enableEntraAuthentication": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable Microsoft Entra sign-in through Azure Container Apps authentication."
      }
    },
    "entraAuthenticationClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Application client ID of the Entra app registration used by Container Apps authentication."
      }
    },
    "entraAuthenticationClientSecret": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Client secret for the Entra app registration used by Container Apps authentication."
      }
    },
    "entraAuthenticationTenantId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Tenant ID for the Entra app registration used by Container Apps authentication."
      }
    },
    "containerAppMinReplicas": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Minimum Container App replicas."
      }
    },
    "containerAppMaxReplicas": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Maximum Container App replicas."
      }
    }
  },
  "variables": {
    "entraAuthenticationSecretName": "entra-auth-client-secret"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[parameters('logAnalyticsWorkspaceName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "retentionInDays": 30,
        "sku": {
          "name": "PerGB2018"
        }
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[parameters('containerAppManagedIdentityName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]"
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('containerAppName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('containerAppManagedIdentityName')))]": {}
        }
      },
      "properties": {
        "environmentId": "[parameters('containerAppsEnvironmentId')]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "allowInsecure": false,
            "external": true,
            "targetPort": 8000,
            "transport": "auto"
          },
          "registries": [
            {
              "server": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('sharedResourceGroupName')), 'Microsoft.ContainerRegistry/registries', parameters('containerRegistryName')), '2023-07-01').loginServer]",
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('containerAppManagedIdentityName'))]"
            }
          ],
          "secrets": "[if(parameters('enableEntraAuthentication'), createArray(createObject('name', variables('entraAuthenticationSecretName'), 'value', parameters('entraAuthenticationClientSecret'))), createArray())]"
        },
        "template": {
          "containers": [
            {
              "name": "foundry-chat-app",
              "image": "[parameters('containerImage')]",
              "env": [
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('containerAppManagedIdentityName')), '2023-01-31').clientId]"
                },
                {
                  "name": "ENTRA_AUTH_ENABLED",
                  "value": "[string(parameters('enableEntraAuthentication'))]"
                },
                {
                  "name": "FOUNDRY_PROJECT_ENDPOINT",
                  "value": "[parameters('foundryProjectEndpoint')]"
                },
                {
                  "name": "FOUNDRY_OPENAI_ENDPOINT",
                  "value": "[parameters('foundryOpenAiEndpoint')]"
                },
                {
                  "name": "FOUNDRY_MODELS",
                  "value": "[parameters('foundryModels')]"
                },
                {
                  "name": "FOUNDRY_REALTIME_ENDPOINT",
                  "value": "[if(empty(parameters('foundryRealtimeEndpoint')), parameters('foundryProjectEndpoint'), parameters('foundryRealtimeEndpoint'))]"
                },
                {
                  "name": "FOUNDRY_REALTIME_MODEL",
                  "value": "[parameters('foundryRealtimeModel')]"
                },
                {
                  "name": "AZURE_STORAGE_ACCOUNT_URL",
                  "value": "[format('https://{0}.blob.{1}', parameters('storageAccountName'), environment().suffixes.storage)]"
                },
                {
                  "name": "AZURE_STORAGE_CONTAINER_NAME",
                  "value": "[parameters('storageContainerName')]"
                },
                {
                  "name": "AZURE_SEARCH_ENDPOINT",
                  "value": "[format('https://{0}.search.windows.net', parameters('searchServiceName'))]"
                },
                {
                  "name": "AZURE_SEARCH_INDEX_NAME",
                  "value": "[parameters('searchIndexName')]"
                },
                {
                  "name": "FOUNDRY_EMBEDDING_MODEL",
                  "value": "[parameters('foundryEmbeddingModel')]"
                }
              ],
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": "[parameters('containerAppMinReplicas')]",
            "maxReplicas": "[parameters('containerAppMaxReplicas')]",
            "rules": [
              {
                "name": "http-scaling",
                "http": {
                  "metadata": {
                    "concurrentRequests": "20"
                  }
                }
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('containerAppManagedIdentityName'))]",
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('sharedResourceGroupName')), 'Microsoft.Resources/deployments', format('rbac-shared-{0}', parameters('containerAppName')))]"
      ]
    },
    {
      "condition": "[parameters('enableEntraAuthentication')]",
      "type": "Microsoft.App/containerApps/authConfigs",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/{1}', parameters('containerAppName'), 'current')]",
      "properties": {
        "platform": {
          "enabled": true,
          "runtimeVersion": "~1"
        },
        "globalValidation": {
          "unauthenticatedClientAction": "AllowAnonymous",
          "redirectToProvider": "azureactivedirectory"
        },
        "httpSettings": {
          "requireHttps": true
        },
        "identityProviders": {
          "azureActiveDirectory": {
            "enabled": true,
            "login": {
              "loginParameters": [
                "prompt=select_account"
              ]
            },
            "registration": {
              "clientId": "[parameters('entraAuthenticationClientId')]",
              "clientSecretSettingName": "[variables('entraAuthenticationSecretName')]",
              "openIdIssuer": "[uri(environment().authentication.loginEndpoint, format('{0}/v2.0', parameters('entraAuthenticationTenantId')))]"
            },
            "validation": {
              "allowedAudiences": [
                "[parameters('entraAuthenticationClientId')]",
                "[format('api://{0}', parameters('entraAuthenticationClientId'))]"
              ]
            }
          }
        },
        "login": {
          "tokenStore": {
            "enabled": false
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', parameters('containerAppName'))]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('rbac-shared-{0}', parameters('containerAppName'))]",
      "resourceGroup": "[parameters('sharedResourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "principalId": {
            "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('containerAppManagedIdentityName')), '2023-01-31').principalId]"
          },
          "containerRegistryName": {
            "value": "[parameters('containerRegistryName')]"
          },
          "storageAccountName": {
            "value": "[parameters('storageAccountName')]"
          },
          "searchServiceName": {
            "value": "[parameters('searchServiceName')]"
          },
          "foundryAccountName": {
            "value": "[parameters('foundryAccountName')]"
          }
        },
