FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project-name>
# The backend derives https://<resource>.services.ai.azure.com/openai/v1 from the project endpoint for model calls.
# Optional bootstrap list. The app stores model deployment names in the configured persistence backend.
FOUNDRY_MODELS=gpt-5.5,gpt-4o-mini

# Local development defaults to SQLite. Azure deployments explicitly use Cosmos DB.
PERSISTENCE_BACKEND=sqlite
# SQLITE_DATABASE_PATH=data/foundry_chat.sqlite3

# Required when PERSISTENCE_BACKEND=cosmos. Use one app-specific container in the shared database.
AZURE_COSMOS_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/
AZURE_COSMOS_DATABASE_NAME=<shared-database-name>
AZURE_COSMOS_CONTAINER_NAME=foundry-chat-app
# Set true only when the identity/key may create containers; otherwise provision it first with /partition_key.
# AZURE_COSMOS_CREATE_CONTAINER=false
# Optional for local development. When omitted, DefaultAzureCredential is used.
# AZURE_COSMOS_KEY=<cosmos-account-key>

# Optional: enables the Foundry Realtime voice demo.
# Defaults to FOUNDRY_PROJECT_ENDPOINT when omitted. You can also set the
# direct OpenAI-compatible endpoint shown by Foundry.
# FOUNDRY_REALTIME_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/openai/v1
FOUNDRY_REALTIME_MODEL=gpt-realtime-2.1

# Optional: enables the Document Q&A RAG use case.
# Uses Azure Blob Storage for original files, Azure AI Search for retrieval, and Foundry for embeddings/chat.
AZURE_STORAGE_ACCOUNT_URL=https://<your-storage-account>.blob.core.windows.net
AZURE_STORAGE_CONTAINER_NAME=foundry-rag-documents
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_INDEX_NAME=foundry-document-rag
FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small
# Optional if the index already exists. Defaults to the dimensions returned by Foundry on upload.
# FOUNDRY_EMBEDDING_DIMENSIONS=1536

# Optional: enables the traditional Foundry STT -> chat -> TTS voice pipeline demo.
# Deployment names must match audio models deployed in your Foundry project.
FOUNDRY_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
FOUNDRY_TTS_MODEL=gpt-4o-mini-tts
FOUNDRY_TTS_VOICE=alloy

# Optional: enables standalone transcription and Live Interpreter.
# The model is selected by the Speech service backing this Foundry resource.
AZURE_SPEECH_ENDPOINT=https://<your-foundry-resource>.cognitiveservices.azure.com/
# Optional fallback when local/API-key authentication is enabled. Microsoft Entra ID is preferred.
# AZURE_SPEECH_KEY=<your-speech-resource-key>
AZURE_SPEECH_TRANSCRIPTION_MODEL=MAI-Transcribe-1.5
# Live Interpreter also requires approved Personal Voice access and a supported region.

# Optional: enables the managed Voice Live travel concierge use case.
# Use the resource root, not a project path. Entra ID authentication is used by default.
AZURE_VOICELIVE_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/
AZURE_VOICELIVE_MODEL=gpt-realtime
AZURE_VOICELIVE_VOICE=en-US-Ava:DragonHDLatestNeural

# Optional: used by the Model metrics dashboard for estimated cost.
FOUNDRY_INPUT_TOKEN_COST_PER_1K=0
FOUNDRY_OUTPUT_TOKEN_COST_PER_1K=0

# Optional: enables automatic model deployment discovery and the Admin > Deploy model UI.
FOUNDRY_SUBSCRIPTION_ID=<your-subscription-id>
FOUNDRY_RESOURCE_GROUP=<your-resource-group>
FOUNDRY_ACCOUNT_NAME=<your-foundry-resource-name>

# Optional: Microsoft Entra sign-in during local development. Register a confidential web app and
# add the exact redirect URI below to Authentication > Web > Redirect URIs.
# ENTRA_LOCAL_CLIENT_ID=<app-registration-client-id>
# ENTRA_LOCAL_CLIENT_SECRET=<app-registration-client-secret-value>
# ENTRA_LOCAL_TENANT_ID=<tenant-id>
# ENTRA_LOCAL_REDIRECT_URI=http://localhost:5173/api/auth/callback
# ENTRA_LOCAL_SESSION_SECRET=<long-random-value-at-least-32-characters>

# Authentication modes: disabled (local demo only), local, or container_apps.
# APP_AUTH_MODE=local
# Container Apps mode also requires the Entra tenant used by the authentication proxy.
# APP_AUTH_TENANT_ID=<tenant-id>
# Optional comma-separated WebSocket origins. Same-origin is required when omitted.
# ALLOWED_ORIGINS=http://localhost:5173
# Maximum concurrent Foundry model operations per application process.
# MODEL_CALL_CONCURRENCY=8
